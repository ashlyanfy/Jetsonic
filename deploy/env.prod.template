# ---------------------------------------------------------------------------
# Production .env template for the Jetsonic landing (jetsonic.aero).
# Copy to /opt/jetsonic-landing/.env on the server, fill in the real values,
# then `chmod 600 .env`. NEVER commit the filled-in file.
#
# Values marked [FROM RAILWAY] must be copied verbatim from the old Railway
# deployment (Raw Editor) or sessions / email / telegram / web-push break.
# ---------------------------------------------------------------------------

# --- Local Postgres container (NOT Railway) ------------------------------
POSTGRES_USER=jetsonic
POSTGRES_PASSWORD=__GENERATE_A_STRONG_PASSWORD__
POSTGRES_DB=jetsonic

# Backend connects to the local db container over the internal network.
DATABASE_URL=postgresql://jetsonic:__SAME_AS_POSTGRES_PASSWORD__@db:5432/jetsonic

# --- Server ---------------------------------------------------------------
NODE_ENV=production
PORT=3000

# --- Domains / CORS -------------------------------------------------------
# All requests are same-origin in production, but Nest refuses to start in
# production with an empty/wildcard CORS_ORIGINS, so list the real origins
# plus the sslip.io test hosts.
CORS_ORIGINS=https://jetsonic.aero,https://www.jetsonic.aero,https://admin.jetsonic.aero,https://landing.2-28-10-92.sslip.io,https://admin.2-28-10-92.sslip.io
ADMIN_BASE_URL=https://admin.jetsonic.aero

# --- Auth [FROM RAILWAY — copy verbatim] ---------------------------------
JWT_SECRET=__FROM_RAILWAY__
JWT_EXPIRES_IN=7d

# --- Email (Resend) [FROM RAILWAY] ---------------------------------------
RESEND_API_KEY=__FROM_RAILWAY__
MAIL_FROM=__FROM_RAILWAY__
MAIL_TO=__FROM_RAILWAY__
SMTP_PASSWORD=__FROM_RAILWAY__

# --- Telegram notifications [FROM RAILWAY] -------------------------------
TELEGRAM_BOT_TOKEN=__FROM_RAILWAY__
TELEGRAM_CHAT_ID=__FROM_RAILWAY__

# --- Web push (VAPID) [FROM RAILWAY — copy verbatim] ---------------------
VAPID_PUBLIC_KEY=__FROM_RAILWAY__
VAPID_PRIVATE_KEY=__FROM_RAILWAY__
